<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base app theme -->
    <style name="Base.Theme.Ad_astra" parent="Theme.Material3.DayNight.NoActionBar" />

    <!-- App theme -->
    <style name="Theme.Ad_astra" parent="Base.Theme.Ad_astra" />

    <!-- Splash theme -->
    <style name="Theme.Ad_astra.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0D2F7A</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="windowSplashScreenIconBackgroundColor">#0D2F7A</item>
        <item name="postSplashScreenTheme">@style/Theme.Ad_astra</item>
    </style>

    <!-- Calendar -->
    <style name="CustomDatePickerTheme" parent="Theme.Material3.Dark.Dialog">
        <item name="colorPrimary">#EC3E2B</item>
        <item name="android:textColorPrimary">#EC3E2B</item>
    </style>

</resources>
